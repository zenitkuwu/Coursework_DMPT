{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Cortex Debug (STM32F429ZI)",
            "cwd": "${workspaceFolder}",
            "executable": "./build/stm32f429_auto_door.elf",
            "request": "launch",
            "type": "cortex-debug",
            "runToEntryPoint": "main",
            "servertype": "openocd",
            "device": "STM32F429ZI",
